# Copy to 01.config/local.env. Do not commit local.env.
DATA_DIR=/path/to/controlled/data
WORK_DIR=/path/to/work
RESULTS_DIR=/path/to/results

# Per-chromosome input prefix; {CHR} is replaced with 1..22 or X.
PGEN_PATTERN=/path/to/ukb_wgs_chr{CHR}

# Prepared sample metadata and phenotype/covariate table.
SAMPLE_TABLE=/path/to/sample_qc_table.tsv
PHENO_COVAR_FILE=/path/to/idp_covariates.tsv

PLINK2=plink2
REGENIE=regenie
THREADS=16

# Final analysis settings.
MIN_MAC=20
STEP1_BSIZE=1000
STEP2_BSIZE=400
